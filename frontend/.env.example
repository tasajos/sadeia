# URL base de la API. En desarrollo se usa el proxy de Vite (/api); en producción,
# si el frontend y la API se sirven desde el mismo dominio (Nginx), deje "/api".
VITE_API_URL=/api
# URL del servidor de sockets (vacío = mismo origen)
VITE_SOCKET_URL=
# Destino del proxy de desarrollo
VITE_PROXY_TARGET=http://localhost:4000
# Teselas del mapa (OpenStreetMap u otro servidor compatible XYZ, p. ej. un tileserver propio)
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Buscador de direcciones al ubicar instituciones (Nominatim/OSM). "false" lo desactiva (redes aisladas).
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
