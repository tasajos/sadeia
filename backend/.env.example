# ---------- Servidor ----------
PORT=4000
NODE_ENV=development
# Zona horaria de operación (Bolivia)
TZ=America/La_Paz
# Orígenes permitidos (frontend web). Separar con comas.
CORS_ORIGINS=http://localhost:5173
# URL pública del backend (se usa para armar las URL de las fotos)
PUBLIC_URL=http://localhost:4000

# ---------- MySQL 8 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sadeia_app
DB_PASSWORD=cambie_esta_clave
DB_NAME=sadeia_db

# ---------- Seguridad (RF-16) ----------
# Genere una clave larga: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie_esta_clave_larga_y_aleatoria
JWT_EXPIRES=8h
MAX_LOGIN_ATTEMPTS=5

# ---------- Motor de IA ----------
# Opcional: URL de un microservicio Python/scikit-learn (POST /predict, POST /train).
# Si se deja vacío se usa el motor explicable integrado en Node.
AI_SERVICE_URL=
# Intervalo del planificador de ingesta y reintentos de notificación (segundos)
SCHEDULER_INTERVAL=45

# ---------- Archivos ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
